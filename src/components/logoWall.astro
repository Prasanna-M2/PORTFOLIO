---
interface TechItem {
  name: string;
  icon: string;
}

const icons = {
  chip: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 6V3M15 6V3M9 21v-3M15 21v-3M6 9H3M6 15H3M21 9h-3M21 15h-3"/><rect x="10" y="10" width="4" height="4"/></svg>`,
  code: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  sensor: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M2 12h3l2-6 4 12 3-8 2 2h6"/></svg>`,
  radio: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/></svg>`,
  bolt: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  panel: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
  cad: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  git: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" y1="9" x2="6" y2="21"/></svg>`,
};

const technologies: TechItem[] = [
  { name: "ESP32", icon: icons.chip },
  { name: "Arduino", icon: icons.chip },
  { name: "C / Embedded C", icon: icons.code },
  { name: "I2C", icon: icons.sensor },
  { name: "LoRa", icon: icons.radio },
  { name: "PZEM", icon: icons.bolt },
  { name: "INA219", icon: icons.bolt },
  { name: "DS18B20", icon: icons.sensor },
  { name: "OLED Display", icon: icons.panel },
  { name: "Siemens PLC", icon: icons.panel },
  { name: "Control Panels", icon: icons.bolt },
  { name: "MATLAB", icon: icons.code },
  { name: "AutoCAD", icon: icons.cad },
  { name: "TinkerCAD", icon: icons.cad },
  { name: "Git & GitHub", icon: icons.git },
];
---

<div class="relative overflow-x-hidden py-8">
  <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--background)] to-transparent z-20"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--background)] to-transparent z-20"></div>

  <div class="flex animate-scroll w-max will-change-transform">
    {
      [...technologies, ...technologies].map((tech, index) => (
        <div
          class="flex items-center gap-2.5 pr-12 md:pr-16 group transition-all duration-300"
          aria-hidden={index >= technologies.length ? "true" : "false"}
        >
          <span
            class="text-[var(--white-icon)] opacity-60 group-hover:text-[var(--sec)] group-hover:opacity-100 transition-all group-hover:scale-110"
            set:html={tech.icon}
          />
          <span class="text-lg font-medium text-[var(--white-icon)] whitespace-nowrap">
            {tech.name}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  @keyframes scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 50s;
    }
  }
</style>
