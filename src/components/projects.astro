---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

interface Project {
  title: string;
  image: string;
  link: string;
  status: string;
  highlights: string[];
}

const projects: Project[] = [
  {
    title: "ESP32-Based Energy Monitoring System",
    image: `${baseUrl}/images/energy-monitoring.svg`,
    link: "https://github.com/Prasanna-M2/Energy-meter-",
    status: "ESP32 | PZEM | OLED",
    highlights: [
      "Built a prototype that measures electrical energy by interfacing 1 PZEM module with an ESP32.",
      "Displayed the readings locally on an OLED screen.",
    ],
  },
  {
    title: "Charge Guard – EV Charger Health & Predictive Maintenance",
    image: `${baseUrl}/images/charge-guard.svg`,
    link: "https://github.com/Prasanna-M2",
    status: "In Progress · 12 V DC Test Rig",
    highlights: [
      "Designed the concept and documented it in a technical report.",
      "Planned a 12 V DC test rig with 1 ESP32, 2 INA219 sensors, 1 DS18B20, an OLED, and a Wi-Fi dashboard.",
    ],
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <article class="group flex flex-col justify-between bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-4 hover:border-[#a476ff45] transition-colors duration-300">
            <div>
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-xl overflow-hidden shadow-lg mb-4"
              >
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-48 md:h-60 object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </a>
              <div class="flex items-start justify-between gap-3 px-1">
                <div>
                  <h4 class="text-xl md:text-2xl font-semibold leading-snug">
                    {project.title}
                  </h4>
                  <span class="inline-block py-1 text-sm text-[var(--sec)]">
                    {project.status}
                  </span>
                </div>
                <a
                  target="_blank"
                  rel="noopener noreferrer"
                  href={project.link}
                  aria-label={`View ${project.title} on GitHub`}
                  class="size-12 shrink-0 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-2.5 rounded-xl bg-[#101010] hover:bg-[var(--white-icon-tr)]"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-6"
                  >
                    <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                  </svg>
                </a>
              </div>
              <ul class="mt-3 px-1 space-y-1.5 text-sm text-[var(--white-icon)]">
                {project.highlights.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[var(--sec)] mt-0.5">•</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://github.com/Prasanna-M2"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-[1.02]"
    >
      <span class="md:text-lg text-md">More projects on GitHub</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
