---
import "@fontsource-variable/montserrat";

interface Props {
  title: string;
}

const { title } = Astro.props;
const siteUrl = "https://prasanna-m2.github.io/PORTFOLIO/";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Prasanna M - B.E. Electrical and Electronics Engineering undergraduate skilled in ESP32, Arduino, C, sensor interfacing, and IoT prototyping."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}/favicon.png`} />
    <link rel="canonical" href={siteUrl} />

    <meta
      property="og:title"
      content="Prasanna M | Embedded Systems & IoT Portfolio"
    />
    <meta
      property="og:description"
      content="Portfolio of Prasanna M, B.E. EEE undergraduate specializing in Embedded Systems, Firmware, IoT prototyping, and industrial electrical automation."
    />
    <meta
      property="og:image"
      content={`${siteUrl}og.image.png`}
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Prasanna M Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Prasanna M",
        "alternateName": "Prasanna M",
        "url": "https://prasanna-m2.github.io/PORTFOLIO/",
        "image": "https://prasanna-m2.github.io/PORTFOLIO/og.image.png",
        "sameAs": [
          "https://github.com/Prasanna-M2",
          "https://www.linkedin.com/in/prasanna-m-2a4344391"
        ],
        "jobTitle": "Embedded Systems & IoT Developer",
        "description": "B.E. Electrical and Electronics Engineering undergraduate skilled in ESP32, Arduino, C, and sensor interfacing."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
